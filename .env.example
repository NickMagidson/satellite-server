# Copy to `.env` and adjust for local or production use.
# `.env` is gitignored — never commit real secrets.

# --- API ---
PORT=3000
UPDATE_INTERVAL_MS=1000
# Keep false in production when the Cesium globe propagates from /api/satellites/elements
LIVE_POSITION_REFRESH_ENABLED=false
OMM_FILE=/app/apps/api/data/omm.sample.json
# Browser origin allowed by CORS (frontend URL). Defaults to local Vite.
CORS_ORIGIN=http://localhost:5173
# Local development chat only. Both flags must be true, with server-only model credentials.
LYNX_CHAT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Postgres (Docker Compose) ---
POSTGRES_USER=satellite
POSTGRES_PASSWORD=satellite
POSTGRES_DB=satellite
# Must match the Postgres credentials above when using Compose
DATABASE_URL=postgresql://satellite:satellite@postgres:5432/satellite

# --- Frontend (build-time for production, runtime for dev compose) ---
FRONTEND_PORT=5173
# VITE_* vars are embedded at build time, not runtime
# For production: set before building the frontend image
VITE_API_URL=http://localhost:3000
VITE_CESIUM_ION_ACCESS_TOKEN=
# Dev compose only:
VITE_SATELLITE_PERF_LOGS=false
VITE_LYNX_CHAT_ENABLED=false

# --- Optional tooling ---
PRISMA_STUDIO_PORT=5555
